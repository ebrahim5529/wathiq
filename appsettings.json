{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=HR_Archive;User=root;Password=;"
  },
  "Archive": {
    "UploadsRoot": "uploads",
    "MaxFileSizeBytes": 10485760,
    "StorageQuotaBytes": 10737418240,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".csv",
      ".ppt",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".zip",
      ".rar",
      ".7z",
      ".txt",
      ".md"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
