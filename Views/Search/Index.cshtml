@model HR.ViewModels.SearchFilterViewModel
@{
    ViewData["Title"] = "البحث المتقدم في الأرشيف";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold">البحث المتقدم في الأرشيف</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active" aria-current="page">البحث المتقدم</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <!-- Search Filters Card with AdminLTE 4 Card Tools -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title fw-bold"><i class="bi bi-funnel-fill me-2 text-primary"></i>معايير وفلاتر البحث</h5>

                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                    </button>
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">كلمة مفتاحية (في الاسم / الوصف / الجهة / الوسوم)</label>
                            <input type="text" name="Query" value="@Model.Query" class="form-control" placeholder="اكتب للبحث..." autofocus />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">الرقم المرجعي / رقم القيد</label>
                            <input type="text" name="ReferenceNo" value="@Model.ReferenceNo" class="form-control" placeholder="مثال: CNT-2026-..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">نوع المستند</label>
                            <select name="DocumentType" class="form-select">
                                <option value="">-- جميع الأنواع --</option>
                                <option value="General" selected="@(Model.DocumentType == HR.Models.DocumentType.General)">عام</option>
                                <option value="Official" selected="@(Model.DocumentType == HR.Models.DocumentType.Official)">مستند رسمي</option>
                                <option value="Contract" selected="@(Model.DocumentType == HR.Models.DocumentType.Contract)">عقد أو اتفاقية</option>
                                <option value="Correspondence" selected="@(Model.DocumentType == HR.Models.DocumentType.Correspondence)">مراسلة أو خطاب</option>
                                <option value="Invoice" selected="@(Model.DocumentType == HR.Models.DocumentType.Invoice)">فاتورة أو مطالبة</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">التصنيف</label>
                            <select name="CategoryId" class="form-select">
                                <option value="">-- جميع التصنيفات --</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">القسم المختص</label>
                            <select name="DepartmentId" class="form-select">
                                <option value="">-- جميع الأقسام --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">@dept.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">امتداد الملف</label>
                            <input type="text" name="Extension" value="@Model.Extension" class="form-control" placeholder="مثال: pdf أو xlsx" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">من تاريخ</label>
                            <input type="date" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">إلى تاريخ</label>
                            <input type="date" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">المستخدم الذي قام بالرفع</label>
                            <input type="text" name="CreatedBy" value="@Model.CreatedBy" class="form-control" placeholder="اسم المستخدم..." />
                        </div>
                        <div class="col-md-4 d-flex align-items-center mt-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IncludeDeleted" value="true" id="includeDeletedCheck" @(Model.IncludeDeleted ? "checked" : "") />
                                <label class="form-check-label small fw-semibold" for="includeDeletedCheck">
                                    تضمين الملفات المحذوفة (الموجودة بالسلة)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex justify-content-end align-items-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> إعادة ضبط
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-search me-1"></i> تنفيذ البحث
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Search Results Card (AdminLTE index2 Table style) -->
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title fw-bold"><i class="bi bi-card-list me-2 text-primary"></i>نتائج البحث</h3>

                <div class="card-tools">
                    @if (Model.HasSearched)
                    {
                        <span class="badge text-bg-primary me-2">@Model.Results.Count نتيجة</span>
                    }
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                    </button>
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!Model.HasSearched)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-search display-3 opacity-25"></i>
                        <p class="mt-2">حدد معايير البحث واضغط "تنفيذ البحث" لعرض النتائج.</p>
                    </div>
                }
                else if (Model.Results.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox display-3 opacity-25"></i>
                        <h5 class="mt-3">لم يتم العثور على أي ملفات تطابق معايير البحث</h5>
                        <p class="small">جرّب تقليل شروط الفلترة أو استخدام كلمات مفتاحية أخرى.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle m-0 table-hover small">
                            <thead class="table-light">
                                <tr>
                                    <th>اسم الملف</th>
                                    <th>نوع المستند</th>
                                    <th>الرقم المرجعي</th>
                                    <th>الجهة / الطرف الثاني</th>
                                    <th>التصنيف</th>
                                    <th>القسم</th>
                                    <th>الحجم</th>
                                    <th>تاريخ الرفع</th>
                                    <th>الحالة</th>
                                    <th class="text-end">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in Model.Results)
                                {
                                    var badgeColor = file.DocumentType switch
                                    {
                                        HR.Models.DocumentType.Official => "text-bg-primary",
                                        HR.Models.DocumentType.Contract => "text-bg-success",
                                        HR.Models.DocumentType.Correspondence => "text-bg-info",
                                        HR.Models.DocumentType.Invoice => "text-bg-warning",
                                        _ => "text-bg-secondary"
                                    };

                                    <tr>
                                        <td>
                                            <a asp-controller="Archive" asp-action="DownloadFile" asp-route-id="@file.Id" class="text-decoration-none fw-bold">
                                                <i class="bi bi-file-earmark-text text-primary me-1"></i>@file.Name
                                            </a>
                                            @if (!string.IsNullOrEmpty(file.Description))
                                            {
                                                <div class="text-muted small">@file.Description</div>
                                            }
                                        </td>
                                        <td><span class="badge @badgeColor">@file.DocumentType</span></td>
                                        <td>@(file.ReferenceNo ?? "—")</td>
                                        <td>@(file.Party ?? "—")</td>
                                        <td>
                                            @if (file.Category != null)
                                            {
                                                <span class="badge text-white" style="background-color: @(file.Category.Color ?? "#6c757d");">@file.Category.Name</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td>@(file.Department?.Name ?? "—")</td>
                                        <td>@Math.Round(file.SizeBytes / 1024.0, 1) KB</td>
                                        <td class="text-muted">@file.CreatedAt.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (file.IsDeleted)
                                            {
                                                <span class="badge text-bg-danger">في السلة</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">نشط</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                @if (file.FolderId.HasValue)
                                                {
                                                    <a asp-controller="Archive" asp-action="Index" asp-route-folderId="@file.FolderId" class="btn btn-outline-secondary" title="فتح المجلد">
                                                        <i class="bi bi-folder2-open"></i>
                                                    </a>
                                                }
                                                <a asp-controller="Archive" asp-action="DownloadFile" asp-route-id="@file.Id" class="btn btn-outline-primary" title="تنزيل">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
