@{
    ViewData["Title"] = "التصنيفات";
    ViewData["Nav"] = "categories";
}
@await Html.PartialAsync("_PageHeader", "التصنيفات")

<div class="app-content">
    <div class="container-fluid">
        <div class="alert alert-info d-flex align-items-center gap-2">
            <i class="bi bi-info-circle"></i>
            <span>لا يمكن حذف تصنيف مرتبط بملفات؛ استخدم التعطيل بدلاً من الحذف، أو أعد تعيين ملفاته أولاً.</span>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="bi bi-tags me-2"></i>قائمة التصنيفات</h3>
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#category-modal">
                    <i class="bi bi-plus-lg me-1"></i> تصنيف جديد
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>الاسم</th>
                                <th>الوصف</th>
                                <th>التصنيف الأب</th>
                                <th>اللون</th>
                                <th>عدد الملفات</th>
                                <th>الحالة</th>
                                <th class="text-end">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><i class="bi bi-folder me-2 text-warning"></i>العقود</td>
                                <td class="text-secondary">جميع العقود والاتفاقيات الرسمية</td>
                                <td>—</td>
                                <td><span class="badge rounded-circle p-2 bg-success" title="أخضر"></span></td>
                                <td>142</td>
                                <td><span class="badge text-bg-success">نشط</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="تعديل" data-bs-toggle="modal" data-bs-target="#category-modal"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-folder me-2 text-warning"></i>الفواتير</td>
                                <td class="text-secondary">فواتير الموردين والمصروفات</td>
                                <td>المالية</td>
                                <td><span class="badge rounded-circle p-2 bg-warning" title="أصفر"></span></td>
                                <td>318</td>
                                <td><span class="badge text-bg-success">نشط</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="تعديل" data-bs-toggle="modal" data-bs-target="#category-modal"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-folder me-2 text-warning"></i>المراسلات</td>
                                <td class="text-secondary">الخطابات الواردة والصادرة</td>
                                <td>—</td>
                                <td><span class="badge rounded-circle p-2 bg-info" title="أزرق"></span></td>
                                <td>96</td>
                                <td><span class="badge text-bg-success">نشط</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="تعديل" data-bs-toggle="modal" data-bs-target="#category-modal"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-folder me-2 text-warning"></i>التقارير</td>
                                <td class="text-secondary">التقارير الدورية والتحليلية</td>
                                <td>—</td>
                                <td><span class="badge rounded-circle p-2 bg-primary" title="أزرق داكن"></span></td>
                                <td>57</td>
                                <td><span class="badge text-bg-success">نشط</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="تعديل" data-bs-toggle="modal" data-bs-target="#category-modal"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-folder me-2 text-warning"></i>المالية <span class="badge text-bg-light ms-1">أب</span></td>
                                <td class="text-secondary">تصنيف رئيسي يحتوي فروعاً</td>
                                <td>—</td>
                                <td><span class="badge rounded-circle p-2 bg-danger" title="أحمر"></span></td>
                                <td>364</td>
                                <td><span class="badge text-bg-success">نشط</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="تعديل" data-bs-toggle="modal" data-bs-target="#category-modal"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-folder me-2 text-warning"></i>أرشيف قديم</td>
                                <td class="text-secondary">ملفات مؤرشفة قبل 2024</td>
                                <td>—</td>
                                <td><span class="badge rounded-circle p-2 bg-secondary" title="رمادي"></span></td>
                                <td>0</td>
                                <td><span class="badge text-bg-secondary">معطّل</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="تعديل" data-bs-toggle="modal" data-bs-target="#category-modal"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-secondary small">6 تصنيفات · 977 ملف مرتبط</div>
        </div>
    </div>
</div>

<div class="modal fade" id="category-modal" tabindex="-1" aria-labelledby="category-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="category-modal-title"><i class="bi bi-tag me-2"></i>بيانات التصنيف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="cat-name">الاسم <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="cat-name" placeholder="اسم التصنيف" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="cat-desc">الوصف</label>
                    <textarea class="form-control" id="cat-desc" rows="2" placeholder="وصف مختصر…"></textarea>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="cat-parent">التصنيف الأب</label>
                        <select class="form-select" id="cat-parent">
                            <option value="">بدون (تصنيف رئيسي)</option>
                            <option>المالية</option>
                            <option>العقود</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="cat-color">اللون</label>
                        <input type="color" class="form-control form-control-color w-100" id="cat-color" value="#0072ce" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="cat-icon">الأيقونة</label>
                        <input type="text" class="form-control" id="cat-icon" placeholder="bi-folder" />
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="cat-active" checked />
                    <label class="form-check-label" for="cat-active">نشط</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ</button>
            </div>
        </div>
    </div>
</div>
