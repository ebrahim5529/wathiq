@model IEnumerable<HR.Models.ArchiveFile>
@{
    ViewData["Title"] = "سلة المحذوفات";
    var deletedFolders = ViewBag.DeletedFolders as List<HR.Models.ArchiveFolder> ?? new();
    var totalDeleted = deletedFolders.Count + Model.Count();
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold text-danger"><i class="bi bi-trash3-fill me-2"></i>سلة المحذوفات</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-end d-flex gap-2">
                    @if (totalDeleted > 0)
                    {
                        <form method="post" asp-action="EmptyTrash" onsubmit="return confirm('تحذير: هل أنت متأكد من تفريغ سلة المحذوفات بالكامل؟ سيتم حذف جميع الملفات والمجلدات نهائياً من القرص.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash3 me-1"></i> تفريغ سلة المحذوفات نهائياً
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (totalDeleted == 0)
        {
            <div class="card mb-4 text-center py-5">
                <div class="card-body">
                    <i class="bi bi-trash3 display-1 text-secondary opacity-25"></i>
                    <h5 class="mt-3 fw-bold">سلة المحذوفات فارغة</h5>
                    <p class="text-secondary small">العناصر المحذوفة من مدير الملفات تنتقل إلى هنا قبل حذفها النهائي.</p>
                </div>
            </div>
        }
        else
        {
            <!-- Deleted Folders Card -->
            @if (deletedFolders.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h3 class="card-title fw-bold text-danger"><i class="bi bi-folder-x me-2"></i>المجلدات المحذوفة</h3>

                        <div class="card-tools">
                            <span class="badge text-bg-danger me-2">@deletedFolders.Count مجلد</span>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم المجلد</th>
                                        <th>القسم</th>
                                        <th>تاريخ الحذف</th>
                                        <th>حذف بواسطة</th>
                                        <th class="text-end">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var folder in deletedFolders)
                                    {
                                        <tr>
                                            <td class="fw-bold"><i class="bi bi-folder-fill text-warning me-2 fs-5"></i>@folder.Name</td>
                                            <td>@(folder.Department?.Name ?? "عام")</td>
                                            <td class="text-muted">@(folder.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                            <td class="text-muted">@(folder.CreatedBy ?? "مدير النظام")</td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <form method="post" asp-action="Restore" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@folder.Id" />
                                                        <input type="hidden" name="itemType" value="Folder" />
                                                        <button type="submit" class="btn btn-outline-success" title="استعادة"><i class="bi bi-arrow-counterclockwise me-1"></i>استعادة</button>
                                                    </form>
                                                    <form method="post" asp-action="DeletePermanently" onsubmit="return confirm('هل تريد حذف هذا المجلد نهائياً؟');" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@folder.Id" />
                                                        <input type="hidden" name="itemType" value="Folder" />
                                                        <button type="submit" class="btn btn-outline-danger" title="حذف نهائي"><i class="bi bi-x-circle me-1"></i>حذف نهائي</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Deleted Files Card -->
            @if (Model.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h3 class="card-title fw-bold text-danger"><i class="bi bi-file-earmark-x me-2"></i>الملفات المحذوفة</h3>

                        <div class="card-tools">
                            <span class="badge text-bg-danger me-2">@Model.Count() ملف</span>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم الملف</th>
                                        <th>نوع المستند</th>
                                        <th>القسم</th>
                                        <th>الحجم</th>
                                        <th>تاريخ الحذف</th>
                                        <th class="text-end">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold"><i class="bi bi-file-earmark-text text-secondary me-2 fs-5"></i>@file.Name</td>
                                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@file.DocumentType</span></td>
                                            <td>@(file.Department?.Name ?? "عام")</td>
                                            <td>@Math.Round(file.SizeBytes / 1024.0, 1) KB</td>
                                            <td class="text-muted">@(file.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <form method="post" asp-action="Restore" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@file.Id" />
                                                        <input type="hidden" name="itemType" value="File" />
                                                        <button type="submit" class="btn btn-outline-success" title="استعادة"><i class="bi bi-arrow-counterclockwise me-1"></i>استعادة</button>
                                                    </form>
                                                    <form method="post" asp-action="DeletePermanently" onsubmit="return confirm('هل أنت متأكد من حذف هذا الملف نهائياً من القرص الصلب؟');" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@file.Id" />
                                                        <input type="hidden" name="itemType" value="File" />
                                                        <button type="submit" class="btn btn-outline-danger" title="حذف نهائي"><i class="bi bi-x-circle me-1"></i>حذف نهائي</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
