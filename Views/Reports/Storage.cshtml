@model HR.ViewModels.StorageReportViewModel
@{
    ViewData["Title"] = "تقرير التخزين واستخدام المساحة";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold">تقرير استهلاك مساحة التخزين</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Statistics">التقارير</a></li>
                        <li class="breadcrumb-item active" aria-current="page">التخزين</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <!-- Top Quota Card (AdminLTE index2 style) -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title fw-bold"><i class="bi bi-hdd-network-fill me-2 text-primary"></i>الحصة التخزينية الإجمالية للنظام</h5>

                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                    </button>
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center">
                        <h6 class="text-secondary small fw-bold mb-1">المساحة الإجمالية المستخدمة</h6>
                        <h2 class="fw-bold text-primary mb-0">@Math.Round(Model.TotalUsedBytes / (1024.0 * 1024 * 1024), 2) <span class="fs-5 fw-normal">GB</span></h2>
                        <span class="text-muted small">من أصل @Math.Round(Model.QuotaBytes / (1024.0 * 1024 * 1024), 0) GB المخصصة</span>
                    </div>
                    <div class="col-md-8 px-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">نسبة الاستهلاك الكلية</span>
                            <span class="badge @(Model.Percentage > 85 ? "text-bg-danger" : Model.Percentage > 65 ? "text-bg-warning" : "text-bg-primary") fs-6">
                                @Model.Percentage%
                            </span>
                        </div>
                        <div class="progress mb-2" style="height: 12px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated @(Model.Percentage > 85 ? "text-bg-danger" : Model.Percentage > 65 ? "text-bg-warning" : "text-bg-primary")"
                                 role="progressbar"
                                 style="width: @Model.Percentage%"
                                 aria-valuenow="@Model.Percentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span>0 GB</span>
                            <span>المساحة المتبقية: @Math.Round((Model.QuotaBytes - Model.TotalUsedBytes) / (1024.0 * 1024 * 1024), 2) GB</span>
                            <span>@Math.Round(Model.QuotaBytes / (1024.0 * 1024 * 1024), 0) GB</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-body">
                <div class="row">
                    <div class="col-md-4 col-6">
                        <div class="text-center">
                            <h5 class="fw-bold mb-0 text-primary">@Math.Round(Model.TotalUsedBytes / (1024.0 * 1024 * 1024), 2) GB</h5>
                            <span class="text-uppercase text-secondary fs-8">المساحة المستخدمة</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-6">
                        <div class="text-center">
                            <h5 class="fw-bold mb-0 text-success">@Math.Round((Model.QuotaBytes - Model.TotalUsedBytes) / (1024.0 * 1024 * 1024), 2) GB</h5>
                            <span class="text-uppercase text-secondary fs-8">المساحة المتبقية</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-12">
                        <div class="text-center">
                            <h5 class="fw-bold mb-0 text-secondary">@Math.Round(Model.QuotaBytes / (1024.0 * 1024 * 1024), 0) GB</h5>
                            <span class="text-uppercase text-secondary fs-8">الحصة التخزينية الكلية</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Department Storage Card -->
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title fw-bold"><i class="bi bi-building me-1 text-primary"></i>استهلاك التخزين حسب الأقسام</h5>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>القسم</th>
                                        <th>عدد الملفات</th>
                                        <th>المساحة المستخدمة</th>
                                        <th>النسبة من الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.DepartmentStats)
                                    {
                                        <tr>
                                            <td class="fw-bold">@d.DepartmentName</td>
                                            <td>@d.FilesCount</td>
                                            <td>@Math.Round(d.SizeBytes / (1024.0 * 1024), 2) MB</td>
                                            <td style="width: 35%;">
                                                <div class="progress-group">
                                                    <span class="float-end fs-8">@d.PercentageOfTotal%</span>
                                                    <div class="progress progress-sm">
                                                        <div class="progress-bar text-bg-primary" style="width: @d.PercentageOfTotal%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Storage Card -->
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title fw-bold"><i class="bi bi-tags me-1 text-success"></i>استهلاك التخزين حسب التصنيفات</h5>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>التصنيف</th>
                                        <th>عدد الملفات</th>
                                        <th>المساحة المستخدمة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.CategoryStats)
                                    {
                                        <tr>
                                            <td class="fw-bold">
                                                <i class="bi bi-tag-fill me-1" style="color: @(c.Color ?? "#6c757d");"></i>
                                                @c.CategoryName
                                            </td>
                                            <td>@c.FilesCount</td>
                                            <td class="text-muted">@Math.Round(c.SizeBytes / (1024.0 * 1024), 2) MB</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- File Types breakdown Card -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title fw-bold"><i class="bi bi-file-earmark-code me-1 text-warning"></i>التوزيع حسب صيغة وامتداد الملف</h5>

                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                    </button>
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>صيغة الملف (Extension)</th>
                                <th>عدد الملفات</th>
                                <th>إجمالي الحجم</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ext in Model.FileTypeStats)
                            {
                                <tr>
                                    <td class="fw-bold"><span class="badge bg-light text-dark border">@ext.Extension</span></td>
                                    <td>@ext.Count</td>
                                    <td>@Math.Round(ext.SizeBytes / (1024.0 * 1024), 2) MB</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
