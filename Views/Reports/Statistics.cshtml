@{
    ViewData["Title"] = "إحصائيات وتقارير الأرشيف";
    var byType = ViewBag.ByType as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var byDept = ViewBag.ByDept as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var byCat = ViewBag.ByCat as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    int totalFiles = ViewBag.TotalFiles ?? 0;
    int totalFolders = ViewBag.TotalFolders ?? 0;
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold">إحصائيات الأرشيف الشاملة</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active" aria-current="page">الإحصائيات</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <!-- Top Info Boxes (AdminLTE index2 style) -->
        <div class="row">
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box">
                    <span class="info-box-icon text-bg-primary shadow-sm"><i class="bi bi-file-earmark-text-fill"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي المستندات</span>
                        <span class="info-box-number">@totalFiles</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box">
                    <span class="info-box-icon text-bg-warning shadow-sm"><i class="bi bi-folder-fill"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي المجلدات</span>
                        <span class="info-box-number">@totalFolders</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box">
                    <span class="info-box-icon text-bg-success shadow-sm"><i class="bi bi-building-fill"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">الأقسام النشطة</span>
                        <span class="info-box-number">@byDept.Count()</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box">
                    <span class="info-box-icon text-bg-info shadow-sm"><i class="bi bi-tags-fill"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">التصنيفات المستخدمة</span>
                        <span class="info-box-number">@byCat.Count()</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- By Document Type Card -->
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title fw-bold"><i class="bi bi-file-earmark-bar-graph me-1 text-primary"></i>الإحصائيات حسب نوع المستند</h5>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>نوع المستند</th>
                                        <th>عدد الملفات</th>
                                        <th>النسبة المئوية</th>
                                        <th>إجمالي الحجم</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in byType)
                                    {
                                        var count = (int)item.Count;
                                        var pct = totalFiles > 0 ? Math.Round(((double)count / totalFiles) * 100, 1) : 0;
                                        var size = (long)item.TotalSize;
                                        <tr>
                                            <td class="fw-bold">@item.Type</td>
                                            <td>@count</td>
                                            <td style="width: 40%;">
                                                <div class="progress-group">
                                                    <span class="float-end fs-8">@pct%</span>
                                                    <div class="progress progress-sm">
                                                        <div class="progress-bar text-bg-primary" style="width: @pct%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted">@Math.Round(size / (1024.0 * 1024.0), 2) MB</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-body text-end">
                        <a asp-action="ExportCsv" asp-route-type="files" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> تصدير البيانات (CSV)
                        </a>
                    </div>
                </div>
            </div>

            <!-- By Department Card -->
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title fw-bold"><i class="bi bi-building me-1 text-info"></i>الإحصائيات حسب الأقسام</h5>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>القسم</th>
                                        <th>عدد الملفات</th>
                                        <th>النسبة من الإجمالي</th>
                                        <th>إجمالي الحجم</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in byDept)
                                    {
                                        var count = (int)item.Count;
                                        var pct = totalFiles > 0 ? Math.Round(((double)count / totalFiles) * 100, 1) : 0;
                                        var size = (long)item.TotalSize;
                                        <tr>
                                            <td class="fw-bold">@item.Dept</td>
                                            <td>@count</td>
                                            <td style="width: 40%;">
                                                <div class="progress-group">
                                                    <span class="float-end fs-8">@pct%</span>
                                                    <div class="progress progress-sm">
                                                        <div class="progress-bar text-bg-info" style="width: @pct%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted">@Math.Round(size / (1024.0 * 1024.0), 2) MB</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-body text-end">
                        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-printer me-1"></i> طباعة
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- By Category Card -->
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title fw-bold"><i class="bi bi-tags-fill me-1 text-success"></i>الإحصائيات حسب تصنيفات الملفات</h5>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم التصنيف</th>
                                        <th>عدد الملفات</th>
                                        <th>الحصة من الأرشيف</th>
                                        <th>إجمالي الحجم</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in byCat)
                                    {
                                        var count = (int)item.Count;
                                        var pct = totalFiles > 0 ? Math.Round(((double)count / totalFiles) * 100, 1) : 0;
                                        var size = (long)item.TotalSize;
                                        <tr>
                                            <td class="fw-bold"><i class="bi bi-tag-fill text-success me-2"></i>@item.Cat</td>
                                            <td>@count</td>
                                            <td style="width: 35%;">
                                                <div class="progress-group">
                                                    <span class="float-end fs-8">@pct%</span>
                                                    <div class="progress progress-sm">
                                                        <div class="progress-bar text-bg-success" style="width: @pct%"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted">@Math.Round(size / (1024.0 * 1024.0), 2) MB</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
