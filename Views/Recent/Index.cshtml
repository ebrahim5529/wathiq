@model IEnumerable<HR.Models.ArchiveFile>
@{
    ViewData["Title"] = "الملفات الأخيرة";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold">الملفات الأخيرة</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active" aria-current="page">الملفات الأخيرة</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title fw-bold"><i class="bi bi-clock-history me-2 text-info"></i>آخر 50 ملف تم رفعه أو تحديثه في النظام</h3>

                <div class="card-tools">
                    <span class="badge text-bg-info me-2">@Model.Count() ملف</span>
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                    </button>
                    <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>اسم الملف</th>
                                <th>المجلد</th>
                                <th>نوع المستند</th>
                                <th>القسم</th>
                                <th>التصنيف</th>
                                <th>الحجم</th>
                                <th>بواسطة</th>
                                <th>تاريخ النشاط</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">لا توجد ملفات حديثة حتى الآن.</td>
                                </tr>
                            }
                            @foreach (var file in Model)
                            {
                                var badgeColor = file.DocumentType switch
                                {
                                    HR.Models.DocumentType.Official => "text-bg-primary",
                                    HR.Models.DocumentType.Contract => "text-bg-success",
                                    HR.Models.DocumentType.Correspondence => "text-bg-info",
                                    HR.Models.DocumentType.Invoice => "text-bg-warning",
                                    _ => "text-bg-secondary"
                                };

                                <tr>
                                    <td class="fw-bold">
                                        <a href="javascript:void(0)" data-preview-file="@file.Id" role="button" class="text-decoration-none" title="معاينة الملف">
                                            <i class="bi bi-file-earmark-text text-primary me-1"></i>@file.Name
                                        </a>
                                    </td>
                                    <td>
                                        @if (file.Folder != null)
                                        {
                                            <a asp-controller="Archive" asp-action="Index" asp-route-folderId="@file.FolderId" class="badge bg-light text-secondary border text-decoration-none">
                                                <i class="bi bi-folder me-1"></i>@file.Folder.Name
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">الرئيسي</span>
                                        }
                                    </td>
                                    <td><span class="badge @badgeColor">@file.DocumentType</span></td>
                                    <td>@(file.Department?.Name ?? "—")</td>
                                    <td>@(file.Category?.Name ?? "—")</td>
                                    <td>@Math.Round(file.SizeBytes / 1024.0, 1) KB</td>
                                    <td class="text-muted">@(file.CreatedBy ?? "النظام")</td>
                                    <td class="text-muted">@((file.UpdatedAt ?? file.CreatedAt).ToString("yyyy-MM-dd HH:mm"))</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-info" data-preview-file="@file.Id" title="معاينة في نافذة منبثقة">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <a asp-controller="Archive" asp-action="DownloadFile" asp-route-id="@file.Id" class="btn btn-outline-primary" title="تنزيل">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-body clearfix">
                <a asp-controller="Archive" asp-action="Index" class="btn btn-sm btn-primary float-start">
                    <i class="bi bi-folder2-open me-1"></i> الذهاب إلى الأرشيف
                </a>
            </div>
        </div>
    </div>
</div>
