@{
    ViewData["Title"] = "المفضلة";
    ViewData["Nav"] = "favorites";
}
@await Html.PartialAsync("_PageHeader", "المفضلة")

<div class="app-content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="bi bi-star me-2 text-warning"></i>العناصر المميّزة</h3>
                <span class="badge text-bg-secondary">6 عناصر</span>
            </div>
            <div class="card-body">
                <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                    <div class="col">
                        <div class="card text-center h-100 position-relative">
                            <button class="btn btn-sm btn-link text-warning position-absolute top-0 end-0 m-1" title="إزالة من المفضلة">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <div class="card-body d-flex flex-column justify-content-center pb-2">
                                <i class="bi bi-folder-fill text-warning display-5 mb-3"></i>
                                <p class="card-title fw-medium small text-break mb-0">مقابلات العملاء</p>
                            </div>
                            <div class="card-footer bg-transparent small text-secondary py-2 d-flex justify-content-between">
                                <span><i class="bi bi-folder me-1"></i> مجلد</span>
                                <span>8 ملفات</span>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card text-center h-100 position-relative">
                            <button class="btn btn-sm btn-link text-warning position-absolute top-0 end-0 m-1" title="إزالة من المفضلة">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <div class="card-body d-flex flex-column justify-content-center pb-2">
                                <i class="bi bi-folder-fill text-warning display-5 mb-3"></i>
                                <p class="card-title fw-medium small text-break mb-0">تخطيط الربع الثاني</p>
                            </div>
                            <div class="card-footer bg-transparent small text-secondary py-2 d-flex justify-content-between">
                                <span><i class="bi bi-folder me-1"></i> مجلد</span>
                                <span>4 ملفات</span>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card text-center h-100 position-relative">
                            <button class="btn btn-sm btn-link text-warning position-absolute top-0 end-0 m-1" title="إزالة من المفضلة">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <a asp-controller="Archive" asp-action="Index" class="text-decoration-none text-body d-flex flex-column h-100">
                                <div class="card-body d-flex flex-column justify-content-center pb-2">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger display-5 mb-3"></i>
                                    <p class="card-title fw-medium small text-break mb-0">design-review.pdf</p>
                                </div>
                                <div class="card-footer bg-transparent small text-secondary py-2 d-flex justify-content-between">
                                    <span>1.4 MB</span>
                                    <span>اليوم</span>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card text-center h-100 position-relative">
                            <button class="btn btn-sm btn-link text-warning position-absolute top-0 end-0 m-1" title="إزالة من المفضلة">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <div class="card-body d-flex flex-column justify-content-center pb-2">
                                <i class="bi bi-file-earmark-word-fill text-info display-5 mb-3"></i>
                                <p class="card-title fw-medium small text-break mb-0">roadmap.docx</p>
                            </div>
                            <div class="card-footer bg-transparent small text-secondary py-2 d-flex justify-content-between">
                                <span>47 KB</span>
                                <span>أمس</span>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card text-center h-100 position-relative">
                            <button class="btn btn-sm btn-link text-warning position-absolute top-0 end-0 m-1" title="إزالة من المفضلة">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <div class="card-body d-flex flex-column justify-content-center pb-2">
                                <i class="bi bi-file-earmark-spreadsheet-fill text-success display-5 mb-3"></i>
                                <p class="card-title fw-medium small text-break mb-0">analytics-may.xlsx</p>
                            </div>
                            <div class="card-footer bg-transparent small text-secondary py-2 d-flex justify-content-between">
                                <span>92 KB</span>
                                <span>16 مايو</span>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card text-center h-100 position-relative">
                            <button class="btn btn-sm btn-link text-warning position-absolute top-0 end-0 m-1" title="إزالة من المفضلة">
                                <i class="bi bi-star-fill"></i>
                            </button>
                            <div class="card-body d-flex flex-column justify-content-center pb-2">
                                <i class="bi bi-file-earmark-pdf-fill text-danger display-5 mb-3"></i>
                                <p class="card-title fw-medium small text-break mb-0">INV-2026-00428.pdf</p>
                            </div>
                            <div class="card-footer bg-transparent small text-secondary py-2 d-flex justify-content-between">
                                <span>184 KB</span>
                                <span>أمس</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
