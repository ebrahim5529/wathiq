@model IEnumerable<HR.Models.ArchiveFile>
@{
    ViewData["Title"] = "الملفات والمجلدات المفضلة";
    var favoriteFolders = ViewBag.FavoriteFolders as List<HR.Models.ArchiveFolder> ?? new();
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold text-warning"><i class="bi bi-star-fill me-2"></i>العناصر المفضلة</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active" aria-current="page">المفضلة</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (favoriteFolders.Count == 0 && !Model.Any())
        {
            <div class="card mb-4 text-center py-5">
                <div class="card-body">
                    <i class="bi bi-star display-1 text-warning opacity-25"></i>
                    <h5 class="mt-3 fw-bold">لا توجد عناصر مضافة إلى المفضلة حالياً</h5>
                    <p class="text-secondary small">يمكنك إضافة أي ملف أو مجلد إلى المفضلة بالنقر على أيقونة النجمة من قائمة الإجراءات.</p>
                    <a asp-controller="Archive" asp-action="Index" class="btn btn-outline-primary btn-sm">الذهاب إلى مدير الملفات</a>
                </div>
            </div>
        }
        else
        {
            <!-- Favorite Folders -->
            @if (favoriteFolders.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h3 class="card-title fw-bold text-warning"><i class="bi bi-folder-fill me-2"></i>المجلدات المفضلة</h3>

                        <div class="card-tools">
                            <span class="badge text-bg-warning me-2">@favoriteFolders.Count مجلد</span>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                            @foreach (var folder in favoriteFolders)
                            {
                                <div class="col">
                                    <div class="card h-100 border text-center p-3 shadow-sm">
                                        <i class="bi bi-folder-fill text-warning display-4 mb-2"></i>
                                        <h6 class="fw-bold mb-1 text-truncate">@folder.Name</h6>
                                        <small class="text-muted mb-3">@(folder.Department?.Name ?? "عام")</small>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-controller="Archive" asp-action="Index" asp-route-folderId="@folder.Id" class="btn btn-sm btn-outline-primary">فتح</a>
                                            <form method="post" asp-controller="Archive" asp-action="ToggleFavorite">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@folder.Id" />
                                                <input type="hidden" name="itemType" value="Folder" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="إزالة من المفضلة">
                                                    <i class="bi bi-star-fill"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Favorite Files Card -->
            @if (Model.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h3 class="card-title fw-bold text-warning"><i class="bi bi-file-earmark-star me-2"></i>الملفات المفضلة</h3>

                        <div class="card-tools">
                            <span class="badge text-bg-warning me-2">@Model.Count() ملف</span>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم الملف</th>
                                        <th>نوع المستند</th>
                                        <th>الرقم المرجعي</th>
                                        <th>القسم / التصنيف</th>
                                        <th>الحجم</th>
                                        <th>تاريخ الإضافة</th>
                                        <th class="text-end">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in Model)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Archive" asp-action="DownloadFile" asp-route-id="@file.Id" class="fw-bold text-decoration-none">
                                                    <i class="bi bi-file-earmark-text text-primary me-2"></i>@file.Name
                                                </a>
                                            </td>
                                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@file.DocumentType</span></td>
                                            <td>@(file.ReferenceNo ?? "—")</td>
                                            <td>
                                                @(file.Department?.Name ?? "—")
                                                @if (file.Category != null)
                                                {
                                                    <span class="text-muted">/ @file.Category.Name</span>
                                                }
                                            </td>
                                            <td>@Math.Round(file.SizeBytes / 1024.0, 1) KB</td>
                                            <td class="text-muted">@file.CreatedAt.ToString("yyyy-MM-dd")</td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-controller="Archive" asp-action="DownloadFile" asp-route-id="@file.Id" class="btn btn-outline-primary" title="تنزيل">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                    <form method="post" asp-controller="Archive" asp-action="ToggleFavorite" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@file.Id" />
                                                        <input type="hidden" name="itemType" value="File" />
                                                        <button type="submit" class="btn btn-outline-warning" title="إزالة من المفضلة">
                                                            <i class="bi bi-star-fill"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }

    </div>
</div>
