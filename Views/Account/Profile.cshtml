@model HR.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "الملف الشخصي";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold text-primary">
                    <i class="bi bi-person-circle me-2"></i>الملف الشخصي
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسي</a></li>
                    <li class="breadcrumb-item active">الملف الشخصي</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <!-- User Info Card -->
            <div class="col-md-5 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 text-center">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <span class="user-avatar bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow" style="width: 80px; height: 80px; font-size: 2.2rem; font-weight: 600;">
                                @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1) : "U")
                            </span>
                        </div>
                        <h5 class="fw-bold mb-1">@Model.FullName</h5>
                        <p class="text-secondary small mb-2">@@@Model.Username</p>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fs-6 mb-3">
                            @Model.RoleName
                        </span>

                        <ul class="list-group list-group-flush text-start small mt-3">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary"><i class="bi bi-envelope me-1"></i>البريد الإلكتروني:</span>
                                <span class="fw-semibold">@Model.Email</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary"><i class="bi bi-building me-1"></i>القسم التابع:</span>
                                <span class="fw-semibold">@(Model.DepartmentName ?? "غير محدد")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary"><i class="bi bi-clock-history me-1"></i>آخر تسجيل دخول:</span>
                                <span class="fw-semibold">@(Model.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "أول تسجيل دخول")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary"><i class="bi bi-calendar-check me-1"></i>تاريخ الإنشاء:</span>
                                <span class="fw-semibold">@Model.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Change Password Card -->
            <div class="col-md-7 col-lg-8 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-body py-3">
                        <h5 class="card-title fw-bold mb-0">
                            <i class="bi bi-shield-lock text-primary me-2"></i>تغيير كلمة المرور
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-action="ChangePassword">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">كلمة المرور الحالية <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-key-fill text-secondary"></i></span>
                                    <input type="password" name="CurrentPassword" class="form-control" placeholder="أدخل كلمة المرور الحالية" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">كلمة المرور الجديدة <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock-fill text-secondary"></i></span>
                                        <input type="password" name="NewPassword" class="form-control" placeholder="6 أحرف على الأقل" minlength="6" required />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">تأكيد كلمة المرور الجديدة <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-check2-circle text-secondary"></i></span>
                                        <input type="password" name="ConfirmPassword" class="form-control" placeholder="أعد إدخال كلمة المرور" minlength="6" required />
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-light border small text-secondary mb-4">
                                <i class="bi bi-info-circle me-1 text-primary"></i> يفضل أن تتضمن كلمة المرور مزيجاً من الحروف والأرقام لتعزيز حماية حسابك.
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i> تحديث كلمة المرور
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
