@model IEnumerable<HR.Models.SystemSetting>
@{
    ViewData["Title"] = "إعدادات النظام";
    var settingsDict = Model.ToDictionary(s => s.Key, s => s.Value);

    string GetVal(string key, string fallback = "") =>
        settingsDict.ContainsKey(key) ? settingsDict[key] : fallback;
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold">إعدادات النظام العامة</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active" aria-current="page">الإعدادات</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <form method="post" asp-action="Save">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-header p-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <ul class="nav nav-pills" id="settingsTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">
                                    <i class="bi bi-sliders me-1"></i> إعدادات عامة
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="storage-tab" data-bs-toggle="tab" data-bs-target="#storage" type="button" role="tab">
                                    <i class="bi bi-hdd-network me-1"></i> التخزين والملفات
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="notifications-tab" data-bs-toggle="tab" data-bs-target="#notifications" type="button" role="tab">
                                    <i class="bi bi-bell me-1"></i> التنبيهات والإشعارات
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">
                                    <i class="bi bi-shield-check me-1"></i> الأمان والجلسات
                                </button>
                            </li>
                        </ul>

                        <div class="card-tools me-2">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tab-content" id="settingsTabsContent">

                        <!-- GENERAL TAB -->
                        <div class="tab-pane fade show active p-2" id="general" role="tabpanel">
                            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-building me-1"></i> هوية المنظومة</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">اسم النظام المعروض</label>
                                    <input type="text" name="settings[SystemName]" value="@GetVal("SystemName", "نظام وثيق للأرشفة الإلكترونية")" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">اللغة الافتراضية</label>
                                    <select name="settings[DefaultLanguage]" class="form-select">
                                        <option value="ar" selected>العربية (Arabic - RTL)</option>
                                        <option value="en">الإنجليزية (English)</option>
                                    </select>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold">نص التذييل (Footer Text)</label>
                                    <input type="text" name="settings[FooterText]" value="@GetVal("FooterText", "نظام وثيق للأرشفة الإلكترونية — جميع الحقوق محفوظة")" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <!-- STORAGE TAB -->
                        <div class="tab-pane fade p-2" id="storage" role="tabpanel">
                            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-hdd-network me-1"></i> سياسات التخزين والرفع</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">الحصة التخزينية الإجمالية (بالجيجابايت GB)</label>
                                    <input type="number" name="settings[StorageQuotaGB]" value="@GetVal("StorageQuotaGB", "50")" class="form-control" />
                                    <div class="form-text small">إجمالي سعة التخزين المخصصة للنظام بالكامل.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">الحد الأقصى لحجم الملف الواحد (بالميجابايت MB)</label>
                                    <input type="number" name="settings[MaxUploadSizeMB]" value="@GetVal("MaxUploadSizeMB", "50")" class="form-control" />
                                    <div class="form-text small">حجم الملف الأقصى المسموح به في الرفعة الواحدة.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">الامتدادات المسموح بها في الرفع</label>
                                    <input type="text" name="settings[AllowedExtensions]" value="@GetVal("AllowedExtensions", ".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.zip,.rar")" class="form-control font-monospace" />
                                    <div class="form-text small">مفصولة بفواصل، مثل: .pdf,.docx,.xlsx</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">أيام الاحتفاظ في سلة المحذوفات قبل الحذف النهائي</label>
                                    <input type="number" name="settings[TrashRetentionDays]" value="@GetVal("TrashRetentionDays", "30")" class="form-control" />
                                    <div class="form-text small">عدد الأيام التي يبقى فيها الملف في السلة.</div>
                                </div>
                            </div>
                        </div>

                        <!-- NOTIFICATIONS TAB -->
                        <div class="tab-pane fade p-2" id="notifications" role="tabpanel">
                            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-bell me-1"></i> التنبيهات التلقائية</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">تنبيه قبل انتهاء العقود (بالأيام)</label>
                                    <input type="number" name="settings[ContractAlertDays]" value="@GetVal("ContractAlertDays", "15")" class="form-control" />
                                    <div class="form-text small">يظهر تنبيه في لوحة المؤشرات عندما يقترب انتهاء العقد بهذا العدد من الأيام.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">نسبة التحذير من امتلاء التخزين (%)</label>
                                    <input type="number" name="settings[StorageWarningPct]" value="@GetVal("StorageWarningPct", "85")" class="form-control" />
                                    <div class="form-text small">إظهار شارة تحذير باللون البرتقالي/الأحمر عند تجاوز هذه النسبة.</div>
                                </div>
                            </div>
                        </div>

                        <!-- SECURITY TAB -->
                        <div class="tab-pane fade p-2" id="security" role="tabpanel">
                            <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-shield-lock me-1"></i> سياسات الأمان</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">مدة مهلة انتهاء الجلسة (بالدقائق)</label>
                                    <input type="number" name="settings[SessionTimeoutMinutes]" value="@GetVal("SessionTimeoutMinutes", "60")" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">تسجيل عناوين IP في سجل التدقيق</label>
                                    <select name="settings[LogIpAddress]" class="form-select">
                                        <option value="true" selected>مفعل (نعم)</option>
                                        <option value="false">معطل</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer bg-body clearfix">
                    <button type="submit" class="btn btn-primary px-4 float-end">
                        <i class="bi bi-check2-circle me-1"></i> حفظ جميع الإعدادات
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
