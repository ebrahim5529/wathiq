@model string
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3">@Model</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Archive" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
