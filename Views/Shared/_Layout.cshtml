@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentType = ViewContext.HttpContext.Request.Query["type"].ToString();
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - نظام الأرشفة الإلكتروني</title>
    <script>
        (() => {
            'use strict';
            const root = document.documentElement;
            if (root.getAttribute('data-lte-color-mode') === 'off') return;
            const STORAGE_KEY = 'lte-theme';
            let stored = null;
            try { stored = localStorage.getItem(STORAGE_KEY); } catch { }
            const authored = root.getAttribute('data-bs-theme');
            let resolved = 'light';
            if (stored === 'dark' || stored === 'light') resolved = stored;
            else if (authored === 'dark' || authored === 'light') resolved = authored;
            else if (globalThis.matchMedia('(prefers-color-scheme: dark)').matches) resolved = 'dark';
            root.setAttribute('data-bs-theme', resolved);
            root.style.colorScheme = resolved;
            if (resolved !== authored) root.setAttribute('data-lte-theme-resolved', '');
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.3.0/index.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.16.0/styles/overlayscrollbars.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.17.2/dist/sweetalert2.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/adminite/css/adminlte.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wathiq-theme.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="القائمة">
                            <i class="bi bi-list fs-5"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-controller="Archive" asp-action="Index" class="nav-link">مدير الملفات</a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link">لوحة المؤشرات</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-2 d-none d-sm-block">
                        <a asp-controller="Search" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-search me-1"></i> بحث سريع
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen" aria-label="ملء الشاشة">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit d-none"></i>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="#" id="bd-theme" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-sun-fill" data-lte-theme-icon="light"></i>
                            <i class="bi bi-moon-fill d-none" data-lte-theme-icon="dark"></i>
                            <i class="bi bi-circle-half d-none" data-lte-theme-icon="auto"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="bd-theme" style="--bs-dropdown-min-width: 8rem">
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light">
                                    <i class="bi bi-sun-fill me-2"></i> فاتح
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark">
                                    <i class="bi bi-moon-fill me-2"></i> داكن
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="auto">
                                    <i class="bi bi-circle-half me-2"></i> تلقائي
                                </button>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-controller="Archive" asp-action="Index" class="brand-link wathiq-brand-link">
                    <img src="~/adminite/assets/img/wathiq-logo.jpg" asp-append-version="true"
                         alt="وثيق - WATHIQ"
                         class="wathiq-brand-logo" />
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2" aria-label="القائمة الرئيسية">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" data-accordion="false" id="navigation">

                        <li class="nav-header text-uppercase opacity-75">الرئيسي</li>
                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(currentController == "Dashboard" ? "active" : "")">
                                <i class="nav-icon bi bi-speedometer2"></i>
                                <p>لوحة التحكم</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Archive" asp-action="Index" class="nav-link @(currentController == "Archive" && string.IsNullOrEmpty(currentType) ? "active" : "")">
                                <i class="nav-icon bi bi-folder2-open"></i>
                                <p>مدير الملفات</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Search" asp-action="Index" class="nav-link @(currentController == "Search" ? "active" : "")">
                                <i class="nav-icon bi bi-search"></i>
                                <p>بحث متقدم</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase opacity-75">الأرشيف</li>
                        <li class="nav-item @(currentController == "Archive" && !string.IsNullOrEmpty(currentType) ? "menu-open" : "")">
                            <a href="#" class="nav-link @(currentController == "Archive" && !string.IsNullOrEmpty(currentType) ? "active" : "")">
                                <i class="nav-icon bi bi-inbox"></i>
                                <p>
                                    أقسام الأرشيف
                                    <i class="nav-arrow bi bi-chevron-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-controller="Archive" asp-action="Index" class="nav-link @(currentController == "Archive" && string.IsNullOrEmpty(currentType) ? "active" : "")">
                                        <i class="nav-icon bi bi-circle-fill fs-6"></i>
                                        <p>كل الملفات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Archive" asp-action="Index" asp-route-type="Official" class="nav-link @(currentType == "Official" ? "active" : "")">
                                        <i class="nav-icon bi bi-file-earmark-check fs-6 text-primary"></i>
                                        <p>المستندات الرسمية</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Archive" asp-action="Index" asp-route-type="Contract" class="nav-link @(currentType == "Contract" ? "active" : "")">
                                        <i class="nav-icon bi bi-pen fs-6 text-success"></i>
                                        <p>العقود والاتفاقيات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Archive" asp-action="Index" asp-route-type="Correspondence" class="nav-link @(currentType == "Correspondence" ? "active" : "")">
                                        <i class="nav-icon bi bi-envelope-paper fs-6 text-info"></i>
                                        <p>المراسلات والخطابات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Archive" asp-action="Index" asp-route-type="Invoice" class="nav-link @(currentType == "Invoice" ? "active" : "")">
                                        <i class="nav-icon bi bi-receipt fs-6 text-warning"></i>
                                        <p>الفواتير والمطالبات</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Categories" asp-action="Index" class="nav-link @(currentController == "Categories" ? "active" : "")">
                                <i class="nav-icon bi bi-tags"></i>
                                <p>التصنيفات</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Departments" asp-action="Index" class="nav-link @(currentController == "Departments" ? "active" : "")">
                                <i class="nav-icon bi bi-building"></i>
                                <p>الأقسام</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase opacity-75">الوصول السريع</li>
                        <li class="nav-item">
                            <a asp-controller="Favorites" asp-action="Index" class="nav-link @(currentController == "Favorites" ? "active" : "")">
                                <i class="nav-icon bi bi-star text-warning"></i>
                                <p>المفضلة</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Recent" asp-action="Index" class="nav-link @(currentController == "Recent" ? "active" : "")">
                                <i class="nav-icon bi bi-clock-history text-info"></i>
                                <p>الملفات الأخيرة</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Shared" asp-action="Index" class="nav-link @(currentController == "Shared" ? "active" : "")">
                                <i class="nav-icon bi bi-share text-primary"></i>
                                <p>المشاركة معي</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Trash" asp-action="Index" class="nav-link @(currentController == "Trash" ? "active" : "")">
                                <i class="nav-icon bi bi-trash text-danger"></i>
                                <p>سلة المحذوفات</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase opacity-75">التقارير والإدارة</li>
                        <li class="nav-item @(currentController == "Reports" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(currentController == "Reports" ? "active" : "")">
                                <i class="nav-icon bi bi-bar-chart"></i>
                                <p>
                                    التقارير
                                    <i class="nav-arrow bi bi-chevron-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="Statistics" class="nav-link @(currentController == "Reports" && currentAction == "Statistics" ? "active" : "")">
                                        <i class="nav-icon bi bi-pie-chart fs-6"></i>
                                        <p>إحصائيات الأرشيف</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="AuditLogs" class="nav-link @(currentController == "Reports" && currentAction == "AuditLogs" ? "active" : "")">
                                        <i class="nav-icon bi bi-journal-text fs-6"></i>
                                        <p>سجل النشاط</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="Storage" class="nav-link @(currentController == "Reports" && currentAction == "Storage" ? "active" : "")">
                                        <i class="nav-icon bi bi-hdd-network fs-6"></i>
                                        <p>التخزين المستخدم</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Users" asp-action="Index" class="nav-link @(currentController == "Users" ? "active" : "")">
                                <i class="nav-icon bi bi-people"></i>
                                <p>المستخدمون</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Roles" asp-action="Index" class="nav-link @(currentController == "Roles" ? "active" : "")">
                                <i class="nav-icon bi bi-shield-lock"></i>
                                <p>الصلاحيات</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Settings" asp-action="Index" class="nav-link @(currentController == "Settings" ? "active" : "")">
                                <i class="nav-icon bi bi-gear"></i>
                                <p>الإعدادات</p>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <main class="app-main">
            @if (TempData["Success"] != null)
            {
                <div class="container-fluid pt-3">
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="container-fluid pt-3">
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                </div>
            }

            <!-- Toast Data Carrier for SweetAlert2 -->
            <div id="wathiqCrudToastData" class="d-none"
                 data-success="@(TempData["Success"]?.ToString())"
                 data-error="@(TempData["Error"]?.ToString())"
                 data-warning="@(TempData["Warning"]?.ToString())"></div>

            @RenderBody()
        </main>

        <footer class="app-footer text-secondary small py-2 px-3 border-top">
            <div class="float-start">
                <strong>نظام وثيق للأرشفة الإلكترونية &copy; @DateTime.UtcNow.Year</strong> — جميع الحقوق محفوظة
            </div>
            <div class="float-end d-none d-sm-inline">
                الإصدار 2.0 (ASP.NET Core 10)
            </div>
        </footer>
    </div>

    <!-- Global File Preview Modal with Download Option -->
    <partial name="_FilePreviewModal" />

    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.16.0/browser/overlayscrollbars.browser.es6.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.17.2/dist/sweetalert2.all.min.js" crossorigin="anonymous"></script>
    <script src="~/adminite/js/adminlte.min.js" asp-append-version="true"></script>
    <script src="~/js/wathiq-confirm.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebarWrapper = document.querySelector('.sidebar-wrapper');
            const isMobile = window.innerWidth <= 992;
            if (sidebarWrapper && globalThis.OverlayScrollbarsGlobal?.OverlayScrollbars && !isMobile) {
                OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
                    scrollbars: { theme: 'os-theme-light', autoHide: 'leave', clickScroll: true }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
