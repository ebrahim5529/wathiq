@model IEnumerable<HR.Models.Department>
@{
    ViewData["Title"] = "إدارة الأقسام";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3 fw-bold">إدارة الأقسام والهيكل التنظيمي</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-end">
                    <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#newDepartmentModal">
                        <i class="bi bi-plus-lg me-1"></i> إضافة قسم جديد
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row g-3">
            @foreach (var dept in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card mb-3 shadow-sm border">
                        <div class="card-header bg-transparent py-2">
                            <h5 class="card-title fw-bold mb-0">
                                <i class="bi bi-building me-1 text-primary"></i>
                                @dept.Name
                            </h5>
                            <div class="card-tools">
                                @if (dept.IsActive)
                                {
                                    <span class="badge text-bg-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">معطل</span>
                                }
                                <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(dept.Code))
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis mb-2">رمز: @dept.Code</span>
                            }
                            <div class="row g-2 my-2 text-center small">
                                <div class="col-6">
                                    <div class="border p-2 rounded bg-body-tertiary">
                                        <div class="fw-bold fs-5 text-warning">@dept.Folders.Count(f => !f.IsDeleted)</div>
                                        <span class="text-secondary fs-8">مجلدات</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border p-2 rounded bg-body-tertiary">
                                        <div class="fw-bold fs-5 text-primary">@dept.Files.Count(f => !f.IsDeleted)</div>
                                        <span class="text-secondary fs-8">ملفات</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-body d-flex justify-content-between align-items-center py-2">
                            <a asp-controller="Archive" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-folder2-open me-1"></i> استعراض الملفات
                            </a>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editDepartmentModal"
                                        data-id="@dept.Id" data-name="@dept.Name" data-code="@dept.Code" data-active="@dept.IsActive.ToString().ToLower()">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@dept.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning" title="@(dept.IsActive ? "تعطيل" : "تفعيل")">
                                        <i class="bi @(dept.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>
                                <form method="post" asp-action="Delete" asp-route-id="@dept.Id" onsubmit="return confirm('هل تريد حذف هذا القسم نهائياً؟');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: New Department -->
<div class="modal fade" id="newDepartmentModal" tabindex="-1" aria-labelledby="newDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="Create" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="newDepartmentModalLabel"><i class="bi bi-plus-circle text-primary me-2"></i>إضافة قسم جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">اسم القسم <span class="text-danger">*</span></label>
                    <input type="text" name="Name" class="form-control" placeholder="مثال: الشؤون الإدارية، المبيعات..." required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label">الرمز المختصر (Code)</label>
                    <input type="text" name="Code" class="form-control" placeholder="مثال: HR, FIN, IT" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> حفظ القسم</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Edit Department -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="Edit" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editDeptId" />
            <div class="modal-header">
                <h5 class="modal-title" id="editDepartmentModalLabel"><i class="bi bi-pencil text-primary me-2"></i>تعديل بيانات القسم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">اسم القسم <span class="text-danger">*</span></label>
                    <input type="text" name="Name" id="editDeptName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">الرمز المختصر</label>
                    <input type="text" name="Code" id="editDeptCode" class="form-control" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editDeptActive" />
                    <label class="form-check-label" for="editDeptActive">قسم نشط</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> حفظ التعديلات</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const editDeptModal = document.getElementById('editDepartmentModal');
        if (editDeptModal) {
            editDeptModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('editDeptId').value = button.getAttribute('data-id');
                document.getElementById('editDeptName').value = button.getAttribute('data-name');
                document.getElementById('editDeptCode').value = button.getAttribute('data-code') || '';
                document.getElementById('editDeptActive').checked = button.getAttribute('data-active') === 'true';
            });
        }
    </script>
}
