@model HR.ViewModels.FileManagerViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="app-content-header py-3 border-bottom mb-3">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-4 fw-bold">
                    <i class="bi bi-folder2-open text-primary me-2"></i>@Model.Title
                    @if (Model.CurrentFolder != null)
                    {
                        <span class="text-secondary fs-6 fw-normal">/ @Model.CurrentFolder.Name</span>
                    }
                </h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Archive" asp-action="Index">الأرشيف</a></li>
                        @foreach (var crumb in Model.Breadcrumbs)
                        {
                            if (crumb.Id == Model.CurrentFolder?.Id)
                            {
                                <li class="breadcrumb-item active" aria-current="page">@crumb.Name</li>
                            }
                            else
                            {
                                <li class="breadcrumb-item"><a asp-controller="Archive" asp-action="Index" asp-route-folderId="@crumb.Id">@crumb.Name</a></li>
                            }
                        }
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row g-3">
            <!-- Sidebar column -->
            <div class="col-lg-3">
                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-primary shadow-sm" type="button" data-bs-toggle="modal" data-bs-target="#uploadModal">
                        <i class="bi bi-cloud-upload me-1"></i> رفع ملفات جديدة
                    </button>
                    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#newFolderModal">
                        <i class="bi bi-folder-plus me-1"></i> إنشاء مجلد جديد
                    </button>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="card-title fw-bold mb-0"><i class="bi bi-diagram-3-fill me-1 text-primary"></i>أقسام الأرشيف</h6>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="list-group list-group-flush small">
                        <a asp-controller="Archive" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.FilterDocumentType == null ? "active fw-bold" : "")">
                            <span><i class="bi bi-folder2 me-2"></i> كل الملفات</span>
                        </a>
                        <a asp-controller="Archive" asp-action="Index" asp-route-type="Official" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.FilterDocumentType == HR.Models.DocumentType.Official ? "active fw-bold" : "")">
                            <span><i class="bi bi-file-earmark-check text-primary me-2"></i> المستندات الرسمية</span>
                        </a>
                        <a asp-controller="Archive" asp-action="Index" asp-route-type="Contract" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.FilterDocumentType == HR.Models.DocumentType.Contract ? "active fw-bold" : "")">
                            <span><i class="bi bi-pen text-success me-2"></i> العقود والاتفاقيات</span>
                        </a>
                        <a asp-controller="Archive" asp-action="Index" asp-route-type="Correspondence" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.FilterDocumentType == HR.Models.DocumentType.Correspondence ? "active fw-bold" : "")">
                            <span><i class="bi bi-envelope-paper text-info me-2"></i> المراسلات والخطابات</span>
                        </a>
                        <a asp-controller="Archive" asp-action="Index" asp-route-type="Invoice" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.FilterDocumentType == HR.Models.DocumentType.Invoice ? "active fw-bold" : "")">
                            <span><i class="bi bi-receipt text-warning me-2"></i> الفواتير والمطالبات</span>
                        </a>
                    </div>
                </div>

                <!-- Storage Info Box (AdminLTE index2 style) -->
                <div class="info-box mb-3 text-bg-primary">
                    <span class="info-box-icon"><i class="bi bi-hdd-network-fill"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">سعة التخزين المستخدمة</span>
                        <span class="info-box-number">@Math.Round(Model.StorageUsedBytes / (1024.0 * 1024 * 1024), 2) / @Math.Round(Model.StorageQuotaBytes / (1024.0 * 1024 * 1024), 0) GB</span>
                        <div class="progress" style="height: 4px;">
                            <div class="progress-bar bg-white" style="width: @Model.StoragePercentage%"></div>
                        </div>
                        <span class="progress-description fs-8 mt-1">@Model.StoragePercentage% مستخدم من الحصة</span>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div class="col-lg-9">
                <div class="card mb-4">
                    <div class="card-header d-flex flex-wrap gap-2 align-items-center py-2">
                        <!-- Breadcrumbs bar -->
                        <nav aria-label="breadcrumb" class="flex-grow-1">
                            <ol class="breadcrumb mb-0 py-1">
                                <li class="breadcrumb-item">
                                    <a asp-controller="Archive" asp-action="Index" title="الرئيسي"><i class="bi bi-house-door"></i></a>
                                </li>
                                @foreach (var crumb in Model.Breadcrumbs)
                                {
                                    <li class="breadcrumb-item">
                                        <a asp-controller="Archive" asp-action="Index" asp-route-folderId="@crumb.Id">@crumb.Name</a>
                                    </li>
                                }
                            </ol>
                        </nav>

                        <!-- Quick Search inside folder -->
                        <form method="get" asp-action="Index" class="d-flex align-items-center">
                            <input type="hidden" name="folderId" value="@Model.CurrentFolderId" />
                            @if (Model.FilterDocumentType.HasValue)
                            {
                                <input type="hidden" name="type" value="@Model.FilterDocumentType.Value" />
                            }
                            <div class="input-group input-group-sm" style="width: 14rem">
                                <input type="search" name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="بحث في هذا المجلد…" aria-label="بحث" />
                                <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                        </form>

                        <!-- Download Folder as Zip if current folder selected -->
                        @if (Model.CurrentFolder != null)
                        {
                            <a asp-action="DownloadFolder" asp-route-id="@Model.CurrentFolder.Id" class="btn btn-sm btn-outline-success" title="تحميل المجلد كاملاً بصيغة ZIP">
                                <i class="bi bi-file-earmark-zip me-1"></i> تحميل ZIP
                            </a>
                        }

                        <div class="card-tools ms-2">
                            <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                                <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                            </button>
                        </div>

                        <!-- View Toggle -->
                        <div class="btn-group btn-group-sm" role="group" aria-label="العرض">
                            <input type="radio" class="btn-check" name="viewToggle" id="view-grid" checked autocomplete="off" />
                            <label class="btn btn-outline-secondary" for="view-grid" title="عرض شبكي">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </label>
                            <input type="radio" class="btn-check" name="viewToggle" id="view-list" autocomplete="off" />
                            <label class="btn btn-outline-secondary" for="view-list" title="عرض قائمة">
                                <i class="bi bi-list-ul"></i>
                            </label>
                        </div>
                    </div>

                    <div class="card-body p-3">
                        @if (Model.Folders.Count == 0 && Model.Files.Count == 0)
                        {
                            <div class="text-center py-5 text-secondary">
                                <i class="bi bi-folder2-open display-1 opacity-25"></i>
                                <h5 class="mt-3">لا توجد ملفات أو مجلدات هنا</h5>
                                <p class="small text-muted">يمكنك البدء بإنشاء مجلد جديد أو رفع الملفات بالنقر على الأزرار الجانبية.</p>
                            </div>
                        }

                        <!-- GRID VIEW -->
                        <div id="grid-view" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                            <!-- FOLDERS -->
                            @foreach (var folder in Model.Folders)
                            {
                                <div class="col">
                                    <div class="card h-100 shadow-sm border position-relative folder-card hover-shadow transition">
                                        <div class="dropdown position-absolute top-0 end-0 m-2" style="z-index: 5;">
                                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a class="dropdown-item" asp-action="DownloadFolder" asp-route-id="@folder.Id">
                                                        <i class="bi bi-download me-2 text-success"></i> تنزيل ZIP
                                                    </a>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#renameModal" data-id="@folder.Id" data-type="Folder" data-name="@folder.Name">
                                                        <i class="bi bi-pencil me-2 text-primary"></i> إعادة تسمية
                                                    </button>
                                                </li>
                                                <li>
                                                    <form method="post" asp-action="ToggleFavorite">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@folder.Id" />
                                                        <input type="hidden" name="itemType" value="Folder" />
                                                        <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi @(folder.IsFavorite ? "bi-star-fill text-warning" : "bi-star") me-2"></i>
                                                            @(folder.IsFavorite ? "إزالة من المفضلة" : "إضافة للمفضلة")
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#shareModal" data-id="@folder.Id" data-type="Folder" data-name="@folder.Name">
                                                        <i class="bi bi-share me-2 text-info"></i> مشاركة
                                                    </button>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form method="post" asp-action="Delete" onsubmit="return confirm('هل تريد نقل هذا المجلد إلى سلة المحذوفات؟');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@folder.Id" />
                                                        <input type="hidden" name="itemType" value="Folder" />
                                                        <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-trash me-2"></i> نقل للسلة
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>

                                        @if (folder.IsFavorite)
                                        {
                                            <span class="position-absolute top-0 start-0 m-2 text-warning" title="في المفضلة">
                                                <i class="bi bi-star-fill"></i>
                                            </span>
                                        }

                                        <a asp-action="Index" asp-route-folderId="@folder.Id" class="card-body text-center text-decoration-none text-body d-flex flex-column justify-content-center pt-4 pb-2">
                                            <i class="bi bi-folder-fill text-warning display-4 mb-2"></i>
                                            <p class="card-title fw-bold small text-truncate mb-0" title="@folder.Name">@folder.Name</p>
                                            @if (folder.Department != null)
                                            {
                                                <span class="badge bg-light text-secondary border mt-1 align-self-center small">@folder.Department.Name</span>
                                            }
                                        </a>
                                        <div class="card-footer bg-transparent small text-secondary py-1 px-2 d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-files me-1"></i> @folder.Files.Count(f => !f.IsDeleted) ملف</span>
                                            <span>@folder.CreatedAt.ToString("MM/dd")</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- FILES -->
                            @foreach (var file in Model.Files)
                            {
                                var iconClass = "bi-file-earmark-fill text-secondary";
                                var ext = (file.Extension ?? "").ToLower();
                                if (ext == ".pdf") { iconClass = "bi-file-earmark-pdf-fill text-danger"; }
                                else if (ext.Contains("doc")) { iconClass = "bi-file-earmark-word-fill text-primary"; }
                                else if (ext.Contains("xls") || ext.Contains("csv")) { iconClass = "bi-file-earmark-spreadsheet-fill text-success"; }
                                else if (ext.Contains("ppt")) { iconClass = "bi-file-earmark-ppt-fill text-warning"; }
                                else if (new[] { ".png", ".jpg", ".jpeg", ".gif", ".webp" }.Contains(ext)) { iconClass = "bi-file-earmark-image-fill text-info"; }
                                else if (new[] { ".zip", ".rar", ".7z" }.Contains(ext)) { iconClass = "bi-file-earmark-zip-fill text-secondary"; }

                                <div class="col">
                                    <div class="card h-100 shadow-sm border position-relative file-card hover-shadow transition">
                                        <div class="dropdown position-absolute top-0 end-0 m-2" style="z-index: 5;">
                                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a class="dropdown-item" asp-action="DownloadFile" asp-route-id="@file.Id">
                                                        <i class="bi bi-download me-2 text-success"></i> تنزيل
                                                    </a>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#renameModal" data-id="@file.Id" data-type="File" data-name="@file.Name">
                                                        <i class="bi bi-pencil me-2 text-primary"></i> إعادة تسمية
                                                    </button>
                                                </li>
                                                <li>
                                                    <form method="post" asp-action="ToggleFavorite">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@file.Id" />
                                                        <input type="hidden" name="itemType" value="File" />
                                                        <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi @(file.IsFavorite ? "bi-star-fill text-warning" : "bi-star") me-2"></i>
                                                            @(file.IsFavorite ? "إزالة من المفضلة" : "إضافة للمفضلة")
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#shareModal" data-id="@file.Id" data-type="File" data-name="@file.Name">
                                                        <i class="bi bi-share me-2 text-info"></i> مشاركة
                                                    </button>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form method="post" asp-action="Delete" onsubmit="return confirm('هل تريد نقل هذا الملف إلى سلة المحذوفات؟');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@file.Id" />
                                                        <input type="hidden" name="itemType" value="File" />
                                                        <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-trash me-2"></i> نقل للسلة
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>

                                        @if (file.IsFavorite)
                                        {
                                            <span class="position-absolute top-0 start-0 m-2 text-warning" title="في المفضلة">
                                                <i class="bi bi-star-fill"></i>
                                            </span>
                                        }

                                        <a asp-action="DownloadFile" asp-route-id="@file.Id" class="card-body text-center text-decoration-none text-body d-flex flex-column justify-content-center pt-4 pb-2">
                                            <i class="bi @iconClass display-4 mb-2"></i>
                                            <p class="card-title fw-medium small text-break mb-1" title="@file.Name">@file.Name</p>
                                            <div>
                                                @if (file.DocumentType != HR.Models.DocumentType.General)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis me-1" style="font-size: 0.7rem;">@file.DocumentType</span>
                                                }
                                                @if (file.Category != null)
                                                {
                                                    <span class="badge text-white" style="background-color: @(file.Category.Color ?? "#6c757d"); font-size: 0.7rem;">@file.Category.Name</span>
                                                }
                                            </div>
                                        </a>

                                        <div class="card-footer bg-transparent small text-secondary py-1 px-2 d-flex justify-content-between align-items-center">
                                            <span>@Math.Round(file.SizeBytes / 1024.0, 0) KB</span>
                                            <span>@file.CreatedAt.ToString("MM/dd")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- LIST VIEW -->
                        <div id="list-view" class="d-none">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>الاسم</th>
                                            <th>النوع</th>
                                            <th>الرقم المرجعي</th>
                                            <th>التصنيف / القسم</th>
                                            <th>الحجم</th>
                                            <th>التاريخ</th>
                                            <th class="text-end">الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var folder in Model.Folders)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-action="Index" asp-route-folderId="@folder.Id" class="text-decoration-none text-body fw-bold">
                                                        <i class="bi bi-folder-fill text-warning me-2 fs-5"></i>@folder.Name
                                                    </a>
                                                    @if (folder.IsFavorite)
                                                    {
                                                        <i class="bi bi-star-fill text-warning ms-1" title="مفضل"></i>
                                                    }
                                                </td>
                                                <td><span class="badge bg-warning-subtle text-warning-emphasis">مجلد</span></td>
                                                <td>—</td>
                                                <td>@(folder.Department?.Name ?? "—")</td>
                                                <td>—</td>
                                                <td class="small text-secondary">@folder.CreatedAt.ToString("yyyy-MM-dd")</td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm">
                                                        <a asp-action="DownloadFolder" asp-route-id="@folder.Id" class="btn btn-outline-success" title="تنزيل ZIP"><i class="bi bi-download"></i></a>
                                                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#renameModal" data-id="@folder.Id" data-type="Folder" data-name="@folder.Name" title="إعادة تسمية"><i class="bi bi-pencil"></i></button>
                                                        <form method="post" asp-action="Delete" onsubmit="return confirm('نقل المجلد إلى السلة؟');" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@folder.Id" />
                                                            <input type="hidden" name="itemType" value="Folder" />
                                                            <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
                                                            <button class="btn btn-outline-danger" type="submit" title="حذف"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }

                                        @foreach (var file in Model.Files)
                                        {
                                            var iconClass = "bi-file-earmark text-secondary";
                                            var ext = (file.Extension ?? "").ToLower();
                                            if (ext == ".pdf") iconClass = "bi-file-earmark-pdf text-danger";
                                            else if (ext.Contains("doc")) iconClass = "bi-file-earmark-word text-primary";
                                            else if (ext.Contains("xls")) iconClass = "bi-file-earmark-spreadsheet text-success";
                                            else if (new[] { ".png", ".jpg", ".jpeg" }.Contains(ext)) iconClass = "bi-file-earmark-image text-info";

                                            <tr>
                                                <td>
                                                    <a asp-action="DownloadFile" asp-route-id="@file.Id" class="text-decoration-none text-body">
                                                        <i class="bi @iconClass me-2 fs-5"></i>@file.Name
                                                    </a>
                                                    @if (file.IsFavorite)
                                                    {
                                                        <i class="bi bi-star-fill text-warning ms-1" title="مفضل"></i>
                                                    }
                                                </td>
                                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@file.DocumentType</span></td>
                                                <td class="small">@(file.ReferenceNo ?? "—")</td>
                                                <td class="small">
                                                    @(file.Category?.Name ?? "—")
                                                    @if (file.Department != null)
                                                    {
                                                        <span class="text-muted">/ @file.Department.Name</span>
                                                    }
                                                </td>
                                                <td class="small">@Math.Round(file.SizeBytes / 1024.0, 1) KB</td>
                                                <td class="small text-secondary">@file.CreatedAt.ToString("yyyy-MM-dd")</td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm">
                                                        <a asp-action="DownloadFile" asp-route-id="@file.Id" class="btn btn-outline-primary" title="تنزيل"><i class="bi bi-download"></i></a>
                                                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#renameModal" data-id="@file.Id" data-type="File" data-name="@file.Name" title="إعادة تسمية"><i class="bi bi-pencil"></i></button>
                                                        <form method="post" asp-action="Delete" onsubmit="return confirm('نقل الملف إلى السلة؟');" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@file.Id" />
                                                            <input type="hidden" name="itemType" value="File" />
                                                            <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
                                                            <button class="btn btn-outline-danger" type="submit" title="حذف"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer bg-body-tertiary small text-secondary d-flex justify-content-between align-items-center py-2">
                        <span>إجمالي العناصر المعروضة: @Model.TotalItemsCount (مجلدات: @Model.Folders.Count | ملفات: @Model.Files.Count)</span>
                        <span>محدث بتاريخ: @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: CREATE FOLDER -->
<div class="modal fade" id="newFolderModal" tabindex="-1" aria-labelledby="newFolderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="CreateFolder" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="parentId" value="@Model.CurrentFolderId" />
            <div class="modal-header">
                <h5 class="modal-title" id="newFolderModalLabel"><i class="bi bi-folder-plus text-primary me-2"></i>إنشاء مجلد جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">اسم المجلد <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" placeholder="أدخل اسم المجلد..." required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label">القسم المسؤول (اختياري)</label>
                    <select name="departmentId" class="form-select">
                        <option value="">-- اختياري (عام) --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> إنشاء المجلد</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: UPLOAD FILES -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-action="UploadFiles" enctype="multipart/form-data" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="folderId" value="@Model.CurrentFolderId" />
            <div class="modal-header">
                <h5 class="modal-title" id="uploadModalLabel"><i class="bi bi-cloud-arrow-up text-primary me-2"></i>رفع ملفات جديدة للأرشيف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">اختر الملفات <span class="text-danger">*</span></label>
                    <input type="file" name="files" multiple class="form-control" required />
                    <div class="form-text">يمكنك اختيار ملف واحد أو عدة ملفات معاً (PDF, Word, Excel, صور, ZIP).</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">نوع المستند</label>
                        <select name="documentType" class="form-select" id="uploadDocType">
                            <option value="General">عام (General)</option>
                            <option value="Official">مستند رسمي (Official)</option>
                            <option value="Contract">عقد أو اتفاقية (Contract)</option>
                            <option value="Correspondence">مراسلة أو خطاب (Correspondence)</option>
                            <option value="Invoice">فاتورة أو مطالبة مالية (Invoice)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">الرقم المرجعي / رقم القيد</label>
                        <input type="text" name="referenceNo" class="form-control" placeholder="مثال: REF-2026-001" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">التصنيف</label>
                        <select name="categoryId" class="form-select">
                            <option value="">-- بدون تصنيف --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">القسم المختص</label>
                        <select name="departmentId" class="form-select">
                            <option value="">-- بدون تحديد قسم --</option>
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">الجهة / الطرف الثاني</label>
                        <input type="text" name="party" class="form-control" placeholder="اسم الشركة أو الجهة الصادر/الوارد إليها..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">تاريخ المستند</label>
                        <input type="date" name="documentDate" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">تاريخ الانتهاء / الاستحقاق</label>
                        <input type="date" name="expiryDate" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">المبلغ (للفواتير/العقود)</label>
                        <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">العملة</label>
                        <input type="text" name="currency" class="form-control" value="SAR" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">الوسوم (مفصولة بفواصل)</label>
                        <input type="text" name="tags" class="form-control" placeholder="مثال: عاجل, قانوني, 2026" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">ملاحظات / وصف المحتوى</label>
                    <textarea name="description" rows="2" class="form-control" placeholder="وصف موجز للمستند أو الملفات المرفوعة..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-cloud-arrow-up me-1"></i> بدء الرفع والتخزين</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: RENAME -->
<div class="modal fade" id="renameModal" tabindex="-1" aria-labelledby="renameModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="Rename" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
            <input type="hidden" name="id" id="renameItemId" />
            <input type="hidden" name="itemType" id="renameItemType" />
            <div class="modal-header">
                <h5 class="modal-title" id="renameModalLabel"><i class="bi bi-pencil text-primary me-2"></i>إعادة التسمية</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">الاسم الجديد</label>
                    <input type="text" name="newName" id="renameItemName" class="form-control" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> حفظ الاسم الجديد</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: SHARE -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="Share" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnFolderId" value="@Model.CurrentFolderId" />
            <input type="hidden" name="itemId" id="shareItemId" />
            <input type="hidden" name="itemType" id="shareItemType" />
            <div class="modal-header">
                <h5 class="modal-title" id="shareModalLabel"><i class="bi bi-share text-primary me-2"></i>مشاركة العنصر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted" id="shareItemNameLabel"></p>
                <div class="mb-3">
                    <label class="form-label">مشاركة مع مستخدم محدد (اسم المستخدم)</label>
                    <input type="text" name="sharedWithUser" class="form-control" placeholder="مثال: sarah أو ahmed" />
                </div>
                <div class="mb-3">
                    <label class="form-label">أو مشاركة مع قسم كامل</label>
                    <select name="departmentId" class="form-select">
                        <option value="">-- لا يوجد --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">مستوى الصلاحية</label>
                    <select name="permission" class="form-select">
                        <option value="View">قراءة / معاينة فقط (View)</option>
                        <option value="Download">معاينة وتنزيل (Download)</option>
                        <option value="Edit">كامل الصلاحيات والتعديل (Edit)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">ملاحظات المشاركة</label>
                    <input type="text" name="notes" class="form-control" placeholder="ملاحظة للمستلم..." />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-share me-1"></i> تأكيد المشاركة</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('view-grid');
            const list = document.getElementById('view-list');
            const gridView = document.getElementById('grid-view');
            const listView = document.getElementById('list-view');

            if (grid && list && gridView && listView) {
                grid.addEventListener('change', () => {
                    gridView.classList.remove('d-none');
                    listView.classList.add('d-none');
                });
                list.addEventListener('change', () => {
                    listView.classList.remove('d-none');
                    gridView.classList.add('d-none');
                });
            }

            // Rename modal setup
            const renameModal = document.getElementById('renameModal');
            if (renameModal) {
                renameModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const type = button.getAttribute('data-type');
                    const name = button.getAttribute('data-name');

                    document.getElementById('renameItemId').value = id;
                    document.getElementById('renameItemType').value = type;
                    document.getElementById('renameItemName').value = name;
                });
            }

            // Share modal setup
            const shareModal = document.getElementById('shareModal');
            if (shareModal) {
                shareModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const type = button.getAttribute('data-type');
                    const name = button.getAttribute('data-name');

                    document.getElementById('shareItemId').value = id;
                    document.getElementById('shareItemType').value = type;
                    document.getElementById('shareItemNameLabel').innerText = 'مشاركة: ' + name;
                });
            }
        });
    </script>
}
