@using System.Net
@using HR.Helpers
@using HR.Models
@model HR.Models.ViewModels.ArchiveIndexViewModel
@{
    ViewData["Title"] = "مدير الملفات";
    ViewData["Nav"] = "file-manager";

    string TypeName(DocumentType? t) => t switch
    {
        DocumentType.Official => "المستندات الرسمية",
        DocumentType.Contract => "العقود",
        DocumentType.Correspondence => "المراسلات",
        DocumentType.Invoice => "الفواتير",
        _ => "كل الملفات"
    };

    // بناء شجرة المجلدات بشكل تعاودي (يُرمّز الاسم للعرض)
    string RenderTree(int? parentId, int depth)
    {
        var sb = new System.Text.StringBuilder();
        var children = Model.AllFolders.Where(f => f.ParentId == parentId).OrderBy(f => f.Name);
        var currentId = Model.CurrentFolder?.Id;
        foreach (var folder in children)
        {
            var active = currentId == folder.Id ? " active" : string.Empty;
            var indent = depth > 0 ? $" style=\"padding-inline-start:{depth * 1.25 + 1.5}rem\"" : string.Empty;
            var count = Model.FileCounts.GetValueOrDefault(folder.Id);
            sb.Append($"<a href=\"/Archive?folderId={folder.Id}\" class=\"list-group-item list-group-item-action d-flex justify-content-between align-items-center{active}\"{indent}>")
              .Append($"<span class=\"text-truncate\"><i class=\"bi bi-folder me-2\" aria-hidden=\"true\"></i>{WebUtility.HtmlEncode(folder.Name)}</span>");
            if (count > 0) sb.Append($"<small class=\"opacity-75\">{count}</small>");
            sb.Append("</a>");
        }
        foreach (var folder in children)
        {
            sb.Append(RenderTree(folder.Id, depth + 1));
        }
        return sb.ToString();
    }
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible m-0" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible m-0" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3">
                    مدير الملفات
                    <span class="badge text-bg-secondary align-middle ms-2">@TypeName(Model.DocumentType)</span>
                </h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-controller="Archive" asp-action="Index">الرئيسية</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@TypeName(Model.DocumentType)</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row g-3">
            <div class="col-lg-3">
                <form asp-controller="Archive" asp-action="Upload" asp-route-folderId="@(Model.CurrentFolder?.Id)" enctype="multipart/form-data" method="post" class="d-grid gap-2 mb-3">
                    <label class="btn btn-primary mb-0">
                        <i class="bi bi-cloud-upload me-1" aria-hidden="true"></i>
                        رفع ملفات
                        <input type="file" name="files" multiple class="d-none" onchange="this.form.submit()" />
                    </label>
                </form>
                <div>
                    <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#new-folder-form" aria-expanded="false" aria-controls="new-folder-form">
                        <i class="bi bi-folder-plus me-1" aria-hidden="true"></i>
                        مجلد جديد
                    </button>
                    <div class="collapse" id="new-folder-form">
                        <form asp-controller="Archive" asp-action="CreateFolder" asp-route-folderId="@(Model.CurrentFolder?.Id)" method="post" class="card card-body mt-2">
                            <label class="form-label small fw-semibold" for="folder-name">اسم المجلد</label>
                            <input type="text" class="form-control form-control-sm" id="folder-name" name="name" maxlength="255" required />
                            <button class="btn btn-sm btn-primary mt-2" type="submit">إنشاء</button>
                        </form>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="list-group list-group-flush">
                        <a asp-controller="Archive" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.CurrentFolder == null ? "active" : "")">
                            <span>
                                <i class="bi bi-house me-2" aria-hidden="true"></i>
                                أرشيفي
                            </span>
                            <small class="opacity-75">@Model.AllFolders.Count</small>
                        </a>
                        @Html.Raw(RenderTree(null, 0))                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-body">
                        <p class="fw-semibold mb-2 small">
                            <i class="bi bi-cloud me-1" aria-hidden="true"></i>
                            التخزين
                        </p>
                        <div class="progress mb-2" style="height: 8px">
                            <div class="progress-bar bg-@(Model.UsedPercent >= 80 ? "danger" : Model.UsedPercent >= 50 ? "warning" : "primary")" role="progressbar" style="width: @Model.UsedPercent%" aria-valuenow="@Model.UsedPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-secondary">
                            تم استخدام @FileUiHelper.FormatSize(Model.UsedBytes) من @FileUiHelper.FormatSize(Model.QuotaBytes)
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="card">
                    <div class="card-header d-flex flex-wrap gap-2 align-items-center">
                        <nav aria-label="breadcrumb" class="flex-grow-1">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item">
                                    <a asp-controller="Archive" asp-action="Index"><i class="bi bi-house" aria-hidden="true"></i></a>
                                </li>
                                @if (Model.Breadcrumb.Count > 0)
                                {
                                    @for (var i = 0; i < Model.Breadcrumb.Count - 1; i++)
                                    {
                                        var folder = Model.Breadcrumb[i];
                                        <li class="breadcrumb-item">
                                            <a asp-controller="Archive" asp-action="Index" asp-route-folderId="@folder.Id">@folder.Name</a>
                                        </li>
                                    }
                                    <li class="breadcrumb-item active" aria-current="page">@Model.Breadcrumb[^1].Name</li>
                                }
                                else if (Model.DocumentType != null)
                                {
                                    <li class="breadcrumb-item active" aria-current="page">@TypeName(Model.DocumentType)</li>
                                }
                            </ol>
                        </nav>
                        <form asp-controller="Archive" asp-action="Index" asp-route-folderId="@(Model.CurrentFolder?.Id)" asp-route-type="@(Model.DocumentType)" method="get" class="input-group input-group-sm" style="width: 14rem">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" class="form-control" name="search" value="@Model.Search" placeholder="بحث في الملفات…" aria-label="بحث" />
                        </form>
                        <div class="btn-group btn-group-sm" role="group" aria-label="العرض">
                            <input type="radio" class="btn-check" name="view" id="view-grid" checked />
                            <label class="btn btn-outline-secondary" for="view-grid">
                                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                            </label>
                            <input type="radio" class="btn-check" name="view" id="view-list" />
                            <label class="btn btn-outline-secondary" for="view-list">
                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                            </label>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="grid-view" class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                            @foreach (var folder in Model.Folders)
                            {
                                var count = Model.FileCounts.GetValueOrDefault(folder.Id);
                                <div class="col">
                                    <a asp-controller="Archive" asp-action="Index" asp-route-folderId="@folder.Id" class="card text-center text-decoration-none text-body h-100 position-relative">
                                        <div class="card-body d-flex flex-column justify-content-center pb-2">
                                            <i class="bi bi-folder-fill text-warning display-5 mb-3" aria-hidden="true"></i>
                                            <p class="card-title fw-medium small text-break mb-0">@folder.Name</p>
                                        </div>
                                        <div class="card-footer bg-transparent small text-secondary py-2">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="text-truncate"><i class="bi bi-folder me-1"></i> @(count > 0 ? $"{count} ملف" : "مجلد")</span>
                                                <span class="text-truncate">@FileUiHelper.RelativeDate(folder.CreatedAt)</span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                            @foreach (var file in Model.Files)
                            {
                                <div class="col">
                                    <a asp-controller="Archive" asp-action="Download" asp-route-id="@file.Id" class="card text-center text-decoration-none text-body h-100 position-relative">
                                        <div class="card-body d-flex flex-column justify-content-center pb-2">
                                            <i class="bi @FileUiHelper.IconClass(file.Extension) display-5 mb-3" aria-hidden="true"></i>
                                            <p class="card-title fw-medium small text-break mb-0">@file.Name</p>
                                        </div>
                                        <div class="card-footer bg-transparent small text-secondary py-2">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="text-truncate">@FileUiHelper.FormatSize(file.SizeBytes)</span>
                                                <span class="text-truncate">@FileUiHelper.RelativeDate(file.UpdatedAt ?? file.CreatedAt)</span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>

                        <div id="list-view" class="d-none">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>الاسم</th>
                                            <th>النوع</th>
                                            <th>الحجم</th>
                                            <th>آخر تعديل</th>
                                            <th class="text-end">إجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var folder in Model.Folders)
                                        {
                                            <tr>
                                                <td><i class="bi bi-folder-fill text-warning me-2"></i> @folder.Name</td>
                                                <td><span class="badge text-bg-light">مجلد</span></td>
                                                <td>—</td>
                                                <td>@FileUiHelper.RelativeDate(folder.CreatedAt)</td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex gap-1">
                                                        <form asp-controller="Archive" asp-action="Rename" method="post" class="d-inline" onsubmit="return renameItem(this)" data-name="@folder.Name">
                                                            <input type="hidden" name="itemType" value="folder" />
                                                            <input type="hidden" name="id" value="@folder.Id" />
                                                            <input type="hidden" name="folderId" value="@(Model.CurrentFolder?.Id)" />
                                                            <input type="hidden" name="newName" value="" />
                                                            <button class="btn btn-sm btn-outline-secondary" type="submit" title="إعادة تسمية"><i class="bi bi-pencil"></i></button>
                                                        </form>
                                                        <form asp-controller="Archive" asp-action="Delete" method="post" class="d-inline" onsubmit="return deleteItem(this)" data-name="@folder.Name">
                                                            <input type="hidden" name="itemType" value="folder" />
                                                            <input type="hidden" name="id" value="@folder.Id" />
                                                            <input type="hidden" name="folderId" value="@(Model.CurrentFolder?.Id)" />
                                                            <button class="btn btn-sm btn-outline-danger" type="submit" title="حذف"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @foreach (var file in Model.Files)
                                        {
                                            <tr>
                                                <td><i class="bi @FileUiHelper.IconClass(file.Extension) me-2"></i> @file.Name</td>
                                                <td>
                                                    <span class="badge text-bg-secondary">@FileUiHelper.TypeName(file.DocumentType)</span>
                                                </td>
                                                <td>@FileUiHelper.FormatSize(file.SizeBytes)</td>
                                                <td>@FileUiHelper.RelativeDate(file.UpdatedAt ?? file.CreatedAt)</td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex gap-1">
                                                        <a asp-controller="Archive" asp-action="Download" asp-route-id="@file.Id" class="btn btn-sm btn-outline-secondary" title="تنزيل"><i class="bi bi-download"></i></a>
                                                        <form asp-controller="Archive" asp-action="Rename" method="post" class="d-inline" onsubmit="return renameItem(this)" data-name="@file.Name">
                                                            <input type="hidden" name="itemType" value="file" />
                                                            <input type="hidden" name="id" value="@file.Id" />
                                                            <input type="hidden" name="folderId" value="@(Model.CurrentFolder?.Id)" />
                                                            <input type="hidden" name="newName" value="" />
                                                            <button class="btn btn-sm btn-outline-secondary" type="submit" title="إعادة تسمية"><i class="bi bi-pencil"></i></button>
                                                        </form>
                                                        <form asp-controller="Archive" asp-action="Delete" method="post" class="d-inline" onsubmit="return deleteItem(this)" data-name="@file.Name">
                                                            <input type="hidden" name="itemType" value="file" />
                                                            <input type="hidden" name="id" value="@file.Id" />
                                                            <input type="hidden" name="folderId" value="@(Model.CurrentFolder?.Id)" />
                                                            <button class="btn btn-sm btn-outline-danger" type="submit" title="حذف"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (Model.TotalItems == 0)
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4">
                                                    <p class="mb-0 text-secondary">
                                                        <i class="bi bi-inbox me-2"></i>
                                                        لا توجد عناصر في هذا الموقع.
                                                    </p>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-secondary small">@Model.TotalItems عنصر</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('view-grid');
            const list = document.getElementById('view-list');
            const gridView = document.getElementById('grid-view');
            const listView = document.getElementById('list-view');
            if (!grid || !list || !gridView || !listView) return;
            grid.addEventListener('change', () => {
                gridView.classList.remove('d-none');
                listView.classList.add('d-none');
            });
            list.addEventListener('change', () => {
                listView.classList.remove('d-none');
                gridView.classList.add('d-none');
            });
        });

        function renameItem(form) {
            const input = form.querySelector('input[name="newName"]');
            const currentName = form.dataset.name || '';
            if (!input) return false;
            const value = prompt('الاسم الجديد:', currentName);
            if (value === null) return false;
            const trimmed = value.trim();
            if (!trimmed) { alert('يرجى إدخال اسم صحيح.'); return false; }
            input.value = trimmed;
            return true;
        }

        function deleteItem(form) {
            const name = form.dataset.name || '';
            return confirm('هل أنت متأكد من نقل "' + name + '" إلى سلة المحذوفات؟');
        }
    </script>
}
