@{
    ViewData["Title"] = "لوحة التحكم";
    ViewData["Nav"] = "dashboard";
}
@await Html.PartialAsync("_PageHeader", "لوحة التحكم")

<div class="app-content">
    <div class="container-fluid">
        <div class="row g-3">
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-primary">
                    <div class="inner">
                        <h3>1,248</h3>
                        <p>إجمالي الملفات</p>
                    </div>
                    <i class="small-box-icon bi bi-file-earmark-text"></i>
                    <a asp-controller="Archive" asp-action="Index" class="small-box-footer link-light">
                        عرض الملفات <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-success">
                    <div class="inner">
                        <h3>86</h3>
                        <p>المجلدات</p>
                    </div>
                    <i class="small-box-icon bi bi-folder"></i>
                    <a asp-controller="Archive" asp-action="Index" class="small-box-footer link-light">
                        تصفح المجلدات <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-warning">
                    <div class="inner">
                        <h3>6.2 <small class="fs-6">جيجا</small></h3>
                        <p>حجم التخزين المستخدم</p>
                    </div>
                    <i class="small-box-icon bi bi-cloud"></i>
                    <a asp-controller="Reports" asp-action="Storage" class="small-box-footer link-light">
                        تقرير التخزين <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-info">
                    <div class="inner">
                        <h3>14</h3>
                        <p>المرفوع اليوم</p>
                    </div>
                    <i class="small-box-icon bi bi-cloud-upload"></i>
                    <a asp-controller="Recent" asp-action="Index" class="small-box-footer link-light">
                        آخر العمليات <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-bar-chart me-2"></i>المرفوعات آخر 7 أيام</h3>
                        <div class="card-tools">
                            <a href="#" class="btn btn-sm btn-outline-secondary">تصدير</a>
                        </div>
                    </div>
                    <div class="card-body">
                        @{
                            var bars = new (string Day, int Count)[]
                            {
                                ("الثلاثاء", 8), ("الأربعاء", 14), ("الخميس", 9), ("الجمعة", 4),
                                ("السبت", 17), ("الأحد", 12), ("الاثنين", 14)
                            };
                            var max = bars.Max(b => b.Count);
                        }
                        <div class="d-flex align-items-end justify-content-between gap-3" style="height: 190px">
                            @foreach (var bar in bars)
                            {
                                var height = Math.Max(8, bar.Count * 100 / max);
                                <div class="flex-fill d-flex flex-column align-items-center justify-content-end gap-1 h-100">
                                    <small class="text-secondary">@bar.Count</small>
                                    <div class="bg-primary rounded-top w-100" style="height: @(height)%; min-height: 6px" title="@bar.Count ملف"></div>
                                    <small class="text-secondary text-nowrap">@bar.Day</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-pie-chart me-2"></i>التوزيع حسب النوع</h3>
                    </div>
                    <div class="card-body">
                        @{
                            var types = new (string Name, string Color, int Value)[]
                            {
                                ("مستندات رسمية", "primary", 38),
                                ("عقود", "success", 24),
                                ("مراسلات", "info", 18),
                                ("فواتير", "warning", 14),
                                ("عام", "secondary", 6)
                            };
                        }
                        @foreach (var t in types)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>@t.Name</span>
                                    <span class="text-secondary">@t.Value%</span>
                                </div>
                                <div class="progress" style="height: 7px">
                                    <div class="progress-bar bg-@t.Color" role="progressbar" style="width: @t.Value%" aria-valuenow="@t.Value" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-clock-history me-2"></i>أحدث الملفات</h3>
                        <div class="card-tools">
                            <a asp-controller="Recent" asp-action="Index" class="btn btn-sm btn-outline-secondary">عرض الكل</a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>الملف</th>
                                        <th>التصنيف</th>
                                        <th>الحجم</th>
                                        <th>تاريخ الرفع</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>design-review.pdf</td>
                                        <td><span class="badge text-bg-secondary">التصميم</span></td>
                                        <td>1.4 MB</td>
                                        <td>اليوم 10:42 ص</td>
                                        <td class="text-end"><a href="#" class="btn btn-sm btn-outline-secondary" title="تنزيل"><i class="bi bi-download"></i></a></td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-file-earmark-word-fill text-info me-2"></i>roadmap.docx</td>
                                        <td><span class="badge text-bg-secondary">الإدارة</span></td>
                                        <td>47 KB</td>
                                        <td>أمس 04:15 م</td>
                                        <td class="text-end"><a href="#" class="btn btn-sm btn-outline-secondary" title="تنزيل"><i class="bi bi-download"></i></a></td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-file-earmark-spreadsheet-fill text-success me-2"></i>analytics-may.xlsx</td>
                                        <td><span class="badge text-bg-secondary">التقارير</span></td>
                                        <td>92 KB</td>
                                        <td>16 مايو 2026</td>
                                        <td class="text-end"><a href="#" class="btn btn-sm btn-outline-secondary" title="تنزيل"><i class="bi bi-download"></i></a></td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>INV-2026-00428.pdf</td>
                                        <td><span class="badge text-bg-secondary">المالية</span></td>
                                        <td>184 KB</td>
                                        <td>15 مايو 2026</td>
                                        <td class="text-end"><a href="#" class="btn btn-sm btn-outline-secondary" title="تنزيل"><i class="bi bi-download"></i></a></td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-file-earmark-zip-fill text-secondary me-2"></i>site-export-2026-05.zip</td>
                                        <td><span class="badge text-bg-secondary">أرشيف</span></td>
                                        <td>12.3 MB</td>
                                        <td>14 مايو 2026</td>
                                        <td class="text-end"><a href="#" class="btn btn-sm btn-outline-secondary" title="تنزيل"><i class="bi bi-download"></i></a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-warning mb-3">
                    <div class="card-header text-bg-warning">
                        <h3 class="card-title"><i class="bi bi-exclamation-triangle me-2"></i>تنبيهات انتهاء العقود</h3>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-file-earmark-text me-2 text-warning"></i>عقد الصيانة السنوي</span>
                            <span class="badge text-bg-danger">ينتهي بعد 5 أيام</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-file-earmark-text me-2 text-warning"></i>عقد توريد المعدات</span>
                            <span class="badge text-bg-warning text-dark">ينتهي بعد 12 يوماً</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-file-earmark-text me-2 text-warning"></i>اتفاقية الدعم الفني</span>
                            <span class="badge text-bg-warning text-dark">ينتهي بعد 20 يوماً</span>
                        </a>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="bi bi-lightning-charge me-2"></i>اختصارات سريعة</h3>
                    </div>
                    <div class="card-body d-grid gap-2">
                        <a asp-controller="Archive" asp-action="Index" class="btn btn-primary"><i class="bi bi-cloud-upload me-1"></i> رفع ملف</a>
                        <a asp-controller="Archive" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-folder-plus me-1"></i> مجلد جديد</a>
                        <a asp-controller="Search" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i> بحث متقدم</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
